-- Durum yönetimi
local autoState = false
local manualOverride = false

local function updateToggleVisual()
    toggleBtn.Text = bypassRunning and "DEACTIVATE BYPASS" or "ACTIVATE BYPASS"
    toggleBtn.BackgroundColor3 = bypassRunning and Color3.fromRGB(65, 65, 65) or Color3.fromRGB(35, 35, 35)
end

local function updateAutoVisual()
    autoPill.BackgroundColor3 = autoState and Color3.fromRGB(205, 205, 205) or Color3.fromRGB(20, 20, 20)
    autoKnob.Position = autoState and UDim2.new(0, 16, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
end

local function setBypass(on)
    on = on == true
    if bypassRunning == on then return end
    if on then
        if not startBypass() then return end
    else
        stopBypass()
    end
    updateToggleVisual()
end

toggleBtn.Activated:Connect(function()
    manualOverride = true
    setBypass(not bypassRunning)
end)

autoPill.Activated:Connect(function()
    autoState = not autoState
    updateAutoVisual()
end)

-- Auto on steal
player:GetAttributeChangedSignal("Stealing"):Connect(function()
    if autoState and not manualOverride then
        local stealing = player:GetAttribute("Stealing") == true
        if stealing ~= bypassRunning then setBypass(stealing) end
    end
    if player:GetAttribute("Stealing") then manualOverride = false end
end)

