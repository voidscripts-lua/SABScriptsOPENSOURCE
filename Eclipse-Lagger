local dragging = false
local function setPower(v)
    v = math.clamp(math.floor(v + 0.5), 0, LAGGER_POWER_MAX)
    LAGGER_CONFIG.TableIncrease = v
    local r = v / LAGGER_POWER_MAX
    powerFill.Size = UDim2.fromScale(r, 1)
    powerKnob.Position = UDim2.new(r, 0, 0.5, 0)
    powerLabel.Text = "POWER: " .. v
    saveSettings({ power = v })
end

powerHitbox.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        local w = powerBar.AbsoluteSize.X
        if w > 0 then setPower(math.clamp((i.Position.X - powerBar.AbsolutePosition.X) / w, 0, 1) * LAGGER_POWER_MAX) end
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local w = powerBar.AbsoluteSize.X
        if w > 0 then setPower(math.clamp((i.Position.X - powerBar.AbsolutePosition.X) / w, 0, 1) * LAGGER_POWER_MAX) end
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then dragging = false end
end)

local function updateVisual(on)
    toggleLabel.Text = on and "LAGGER: ON" or "LAGGER: OFF"
    TweenService:Create(knob, TweenInfo.new(0.15), {
        Position = on and UDim2.new(1, -17, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
    }):Play()
end

toggleBtn.Activated:Connect(function()
    local on = toggleMainLagger()
    updateVisual(on)
end)
closeBtn.Activated:Connect(function() screenGui.Enabled = false end)

-- Sürükle
local drag, dragInput, dragStart, startPos = false, nil, nil, nil
mainFrame.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        drag = true; dragInput = i; dragStart = i.Position; startPos = mainFrame.Position
    end
end)
mainFrame.InputChanged:Connect(function(i)
    if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        dragInput = i
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if drag and i == dragInput then
        local d = i.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if drag and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then drag = false end
end)

-- Global API (ana script açısından)
_G.CrystalLagger = {
    IsEnabled = function() return laggerStates.Main end,
    SetEnabled = function(v)
        if laggerStates.Main ~= v then
            laggerStates.Main = v
            if v then startMainLag() else stopMainLag() end
            updateVisual(v)
        end
    end,
    Toggle = function() local on = toggleMainLagger(); updateVisual(on); return on end,
    SetVisible = function(v) screenGui.Enabled = v end,
    Stop = function() stopMainLag() end,
    ResetPosition = function() mainFrame.Position = UDim2.new(0.5, -135, 0.5, -58) end,
    GetPower = function() return LAGGER_CONFIG.TableIncrease end,
    SetPower = function(v) setPower(v) end,
}

